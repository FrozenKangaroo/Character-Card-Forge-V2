        {"id":"fp_enabled","key_path":"enabled","label":"Realism Engine default","type":"checkbox","default":false,"generate":true},
        {"id":"fp_short_term_bond","key_path":"short_term_bond","label":"Short-term bond","type":"number","default":0,"minimum":-300,"maximum":300,"step":1,"generate":true},
        {"id":"fp_long_term_bond","key_path":"long_term_bond","label":"Long-term bond","type":"number","default":0,"minimum":-300,"maximum":300,"step":1,"generate":true},
        {"id":"fp_trust_level","key_path":"trust_level","label":"Trust level","type":"number","default":0,"minimum":-100,"maximum":100,"step":1,"generate":true},
        {"id":"fp_day_count","key_path":"day_count","label":"Starting story day","type":"number","default":1,"minimum":1,"maximum":99999,"step":1,"generate":true},
        {"id":"fp_time_of_day","key_path":"time_of_day","label":"Starting time of day","type":"select","default":"morning","options":["dawn","morning","late_morning","afternoon","evening","night"],"generate":true},
        {"id":"fp_story_start_date","key_path":"story_start_date","label":"Story start date","type":"line","default":"","placeholder":"Optional YYYY-MM-DD","generate":true},
        {"id":"fp_story_start_time","key_path":"story_start_time","label":"Story start time","type":"line","default":"","placeholder":"Optional HH:MM","generate":true},
        {"id":"fp_character_emotion","key_path":"character_emotion","label":"Starting emotion","type":"line","default":"","generate":true,"placeholder":"e.g. amused confidence masking nervousness"},
        {"id":"fp_emotion_intensity","key_path":"emotion_intensity","label":"Emotion intensity","type":"select","default":"mild","options":["mild","moderate","strong"],"generate":true},
        {"id":"fp_nsfw_cooldown","key_path":"nsfw_cooldown_enabled","label":"NSFW cooldown default","type":"checkbox","default":false,"generate":true},
        {"id":"fp_passage_of_time","key_path":"passage_of_time_enabled","label":"Automatic passage of time","type":"checkbox","default":true,"generate":true},
        {"id":"fp_chaos_mode","key_path":"chaos_mode_enabled","label":"Chaos Mode default","type":"checkbox","default":false,"generate":true}
      ]
    },
    {
