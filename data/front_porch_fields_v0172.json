    {"id":"seed_day_count","key_path":"day_count","label":"Story day","type":"number","default":1,"minimum":1,"maximum":99999,"step":1,"generate":true},
    {"id":"seed_time_of_day","key_path":"time_of_day","label":"Time of day","type":"select","default":"morning","options":["dawn","morning","late_morning","afternoon","evening","night"],"generate":true},
