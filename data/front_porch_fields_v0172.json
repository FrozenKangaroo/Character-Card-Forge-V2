    {"id":"seed_inventory_carrying","key_path":"inventory.carrying","label":"Carrying override","type":"tags","default":[],"generate":true}
  ],
  "groups": [
    {
      "id": "character_life",
      "label": "Character Life",
      "description": "Optional identity and everyday-life details that travel with the character card.",
      "fields": [
        {"id":"fp_ambitions","key_path":"ambitions","label":"Long-term ambitions","type":"tags","default":[],"generate":true,"generation_prompt":"Short long-term goals belonging to the character, one concise phrase per item. These are not a to-do list and must not prescribe {{user}}'s choices."},
        {"id":"fp_plan_lines","key_path":"plan_lines","label":"Plan lines","type":"tags","default":[],"generate":true,"generation_prompt":"Short character-owned plan or intention sentences. Do not invent actions, feelings or history for {{user}}."},
        {"id":"fp_occupation","key_path":"occupation","label":"Occupation","type":"line","default":"","generate":true,"placeholder":"e.g. librarian"},
        {"id":"fp_occupation_brief","key_path":"occupationBrief","label":"What the job involves","type":"multiline","height":90,"default":"","generate":true,"generation_prompt":"Ground at-work narration in one concise description of what this job actually involves."},
        {"id":"fp_work_hours","key_path":"hours","label":"Work hours","type":"line","default":"","generate":true,"placeholder":"e.g. 09:00–17:00"},
        {"id":"fp_work_days","key_path":"workDays","label":"Work days","type":"integer_tags","default":[1,2,3,4,5],"generate":true,"placeholder":"1, 2, 3, 4, 5 (Monday=1, Sunday=7)","minimum":1,"maximum":7},
        {"id":"fp_birthday","key_path":"birthday","label":"Birthday","type":"line","default":"","generate":true,"placeholder":"YYYY-MM-DD (February 29 is not supported)"},
        {"id":"fp_likes","key_path":"likes","label":"Drawn to / likes","type":"tags","default":[],"generate":true,"generation_prompt":"Specific things this character warms to, one short phrase per item."},
        {"id":"fp_dislikes","key_path":"dislikes","label":"Put off by / dislikes","type":"tags","default":[],"generate":true,"generation_prompt":"Specific things that make this character bristle, one short phrase per item."},
        {"id":"fp_intimate_into","key_path":"intimate_preferences.into","label":"Intimate preferences — warms to","type":"tags","default":[],"generate":true,"adult":true,"generation_prompt":"Suggestive adult preferences only. Keep them character-owned, consensual, non-humiliating and non-prescriptive of {{user}}."},
        {"id":"fp_intimate_not_into","key_path":"intimate_preferences.not_into","label":"Intimate preferences — not interested in","type":"tags","default":[],"generate":true,"adult":true,"generation_prompt":"Adult boundaries or disinterests only. Keep them character-owned and never prescribe {{user}}."},
        {"id":"fp_inventory_worn","key_path":"inventory.worn","label":"Wearing","type":"tags","default":[],"generate":true,"generation_prompt":"Up to eight starting wardrobe items. A condition may be written in parentheses, for example: sundress (rain-soaked)."},
        {"id":"fp_inventory_carrying","key_path":"inventory.carrying","label":"Carrying","type":"tags","default":[],"generate":true,"generation_prompt":"Up to eight objects the character carries when a new conversation starts."}
      ]
    },
    {
      "id": "opening_state",
      "label": "Opening State",
      "description": "Optional starting values for new Front Porch conversations. Existing conversations keep their living state.",
