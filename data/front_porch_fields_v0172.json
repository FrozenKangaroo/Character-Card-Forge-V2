{
  "format_version": 1,
  "front_porch_extension_version": "2.5",
  "greeting_seed_fields": [
    {"id":"seed_character_emotion","key_path":"character_emotion","label":"Opening emotion","type":"line","default":"","generate":true},
    {"id":"seed_emotion_intensity","key_path":"emotion_intensity","label":"Emotion intensity","type":"select","default":"mild","options":["mild","moderate","strong"],"generate":true},
    {"id":"seed_short_term_bond","key_path":"short_term_bond","label":"Short-term bond","type":"number","default":0,"minimum":-300,"maximum":300,"step":1,"generate":true},
    {"id":"seed_long_term_bond","key_path":"long_term_bond","label":"Long-term bond","type":"number","default":0,"minimum":-300,"maximum":300,"step":1,"generate":true},
