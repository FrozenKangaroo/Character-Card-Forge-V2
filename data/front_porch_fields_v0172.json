        {"id":"fp_baseline_energy","key_path":"needs_baseline_energy","label":"Energy baseline","type":"number","default":80,"minimum":0,"maximum":100,"step":1,"generate":true},
        {"id":"fp_decay_energy","key_path":"needs_decay_energy","label":"Energy decay / turn","type":"number","default":3,"minimum":0,"maximum":10,"step":1,"generate":true},
        {"id":"fp_baseline_social","key_path":"needs_baseline_social","label":"Social baseline","type":"number","default":80,"minimum":0,"maximum":100,"step":1,"generate":true},
        {"id":"fp_decay_social","key_path":"needs_decay_social","label":"Social decay / turn","type":"number","default":2,"minimum":0,"maximum":10,"step":1,"generate":true},
        {"id":"fp_baseline_fun","key_path":"needs_baseline_fun","label":"Fun baseline","type":"number","default":80,"minimum":0,"maximum":100,"step":1,"generate":true},
        {"id":"fp_decay_fun","key_path":"needs_decay_fun","label":"Fun decay / turn","type":"number","default":2,"minimum":0,"maximum":10,"step":1,"generate":true},
        {"id":"fp_baseline_hygiene","key_path":"needs_baseline_hygiene","label":"Hygiene baseline","type":"number","default":80,"minimum":0,"maximum":100,"step":1,"generate":true},
        {"id":"fp_decay_hygiene","key_path":"needs_decay_hygiene","label":"Hygiene decay / turn","type":"number","default":1,"minimum":0,"maximum":10,"step":1,"generate":true},
        {"id":"fp_baseline_comfort","key_path":"needs_baseline_comfort","label":"Comfort baseline","type":"number","default":80,"minimum":0,"maximum":100,"step":1,"generate":true},
        {"id":"fp_decay_comfort","key_path":"needs_decay_comfort","label":"Comfort decay / turn","type":"number","default":2,"minimum":0,"maximum":10,"step":1,"generate":true}
      ]
    },
    {
      "id": "advanced",
      "label": "Advanced Front Porch",
      "description": "Optional verification, identity, avatar and presentation settings. IDs and appearance values are manual-only.",
      "fields": [
        {"id":"fp_verification_enabled","key_path":"realism_verification_enabled","label":"Realism verification","type":"checkbox","default":false,"generate":true},
        {"id":"fp_verification_reprocesses","key_path":"realism_verification_max_reprocesses","label":"Maximum verification reprocesses","type":"number","default":1,"minimum":1,"maximum":5,"step":1,"generate":true},
        {"id":"fp_verification_strictness","key_path":"realism_verification_strictness","label":"Verification strictness","type":"number","default":3,"minimum":1,"maximum":5,"step":1,"generate":true},
        {"id":"fp_director_authority","key_path":"realism_needs_director_authority","label":"Director authority over needs","type":"checkbox","default":false,"generate":true},
        {"id":"fp_current_task","key_path":"current_task","label":"Starting task / objective","type":"multiline","height":90,"default":"","generate":true,"generation_prompt":"An optional character-owned starting objective. Do not make {{user}} responsible for completing it."},
        {"id":"fp_stable_id","key_path":"stable_id","label":"Stable character ID","type":"line","default":"","generate":false,"placeholder":"Optional UUID supplied by Front Porch"},
        {"id":"fp_tier","key_path":"tier","label":"Character tier","type":"select","default":"lite","options":["lite"],"generate":false},
        {"id":"fp_avatar_locked","key_path":"avatar_locked","label":"Lock avatar width","type":"checkbox","default":false,"generate":false},
        {"id":"fp_favorite_avatar","key_path":"favorite_avatar_id","label":"Favourite avatar ID","type":"line","default":"","generate":false},
