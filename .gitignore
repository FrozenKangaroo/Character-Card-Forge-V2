# Godot generated files
.godot/

# GDScript UID sidecars are currently regenerated by Godot 4.6 in local checkouts.
# Ignore them until the project intentionally adopts and commits one canonical UID set.
*.gd.uid

# Local and CI export output
build/
dist/
exports/

# Export credentials and signing material
export_credentials.cfg
*.keystore
*.pfx
*.p12

# Secrets and local configuration
.env
.env.*
secrets/

# Python helper caches
__pycache__/
*.py[cod]

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
